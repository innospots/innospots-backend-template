<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <!--<Configuration status="WARN" monitorInterval="30"> -->
    <properties>
        <property name="LOG_HOME">${sys:LOG_PATH:-logs}</property>
        <property name="applicationName">backend-template-server-admin</property>
    </properties>
    <Appenders>
        <!--*********************控制台日志***********************-->
        <Console name="consoleAppender" target="SYSTEM_OUT">
            <!--设置日志格式-->
            <PatternLayout
                    pattern="%d{ISO8601} %-5level [%t] [traceId=%X{traceId}] %C{} %M(%L): %msg%n%throwable"
                    disableAnsi="true"/>
        </Console>

    </Appenders>

    <Loggers>
        <!-- 根日志设置 -->
        <Root level="info">
            <AppenderRef ref="consoleAppender" level="all"/>
        </Root>

        <Logger name="org.springframework" level="info"/>
        <Logger name="org.springframework.web" level="info"/>
        <Logger name="org.mybatis" level="info"/>
        <Logger name="org.hibernate" level="warn"/>
        <Logger name="com.zaxxer.hikari" level="info"/>
        <Logger name="org.quartz" level="info"/>
        <Logger name="org.apache.kafka.clients.consumer.internals" level="warn"/>
        <Logger name="com.baomidou.mybatisplus" level="info"/>
        <Logger name="io.innospots" level="debug"/>
        <Logger name="io.innospots.libra.kernel" level="info"/>
        <Logger name="io.innospots.libra.kernel.module.logger.aspect" level="debug"/>
        <Logger name="io.innospots.libra.base.dao" level="info"/>
        <Logger name="io.innospots.libra.kernel.interceptor" level="info"/>
        <Logger name="io.innospots.libra.kernel.module.i18n.service.I18nTransMessageService" level="debug"/>
        <Logger name="io.innospots.base.data" level="info"/>
        <Logger name="io.innospots.libra.base.filter" level="debug"/>
        <!-- scan schedule execution -->
        <AsyncLogger name="io.innospots.base.data.operator.jdbc" level="info"/>
        <AsyncLogger name="io.innospots.base.data.operator" level="info"/>
        <AsyncLogger name="io.innospots.connector.schema.dao" level="info"/>
        <AsyncLogger name="io.innospots.workflow.core.instance" level="info"/>
        <AsyncLogger name="io.innospots.workflow.core.watcher" level="info"/>
        <AsyncLogger name="io.innospots.workflow.core.watcher" level="info"/>
        <AsyncLogger name="io.innospots.base.entity.handler" level="info"/>
        <AsyncLogger name="io.innospots.base.server.ServiceRegistryHolder" level="info"/>
        <AsyncLogger name="io.innospots.connector.ai" level="debug"/>
        <AsyncLogger name="io.innospots.base.utils.CCH" level="info"/>
        <AsyncLogger name="io.innospots.server.base.registry" level="info"/>
        <AsyncLogger name="io.innospots.base.server.ServiceRegistryHolder" level="info"/>
        <AsyncLogger name="io.innospots.libra.kernel.module.i18n.dao" level="info"/>
    </Loggers>

</Configuration>